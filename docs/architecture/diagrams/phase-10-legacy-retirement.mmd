flowchart TD
    nativeRaw["Retained native production<br/>signed release + ledger + renewals + audits"]
    native["aqt-retirement assemble-native + verify-native<br/>pinned trust root + bounded continuity"]
    legacyRaw["Raw final MT5 + broker + service evidence<br/>report + export + status + pause + writer checks"]
    archiveRaw["Eleven-category legacy archive<br/>restore + recursive scan + annotated tag evidence"]
    archive["aqt-retirement assemble-archive + verify-archive<br/>exact inventory + pinned scan policy + retention"]
    legacy["aqt-retirement assemble-final-state + verify-final-state<br/>derived counts + cross-source reconciliation + freshness"]
    readiness["aqt-retirement assemble-readiness + verify-readiness<br/>dual-root replay + shared retirement identity"]
    evaluate["aqt-retirement evaluate-readiness<br/>replays sources + no side effects"]
    stopReview{"All readiness gates pass?"}
    stopWait["AWAITING STOP APPROVAL"]
    stopSign["Offline Ed25519 approval<br/>scope: stop_and_observe"]
    disable["Operator runbook<br/>disable exact legacy capabilities"]
    observe["Seven-day reversible observation<br/>files retained + credentials quarantined"]
    disabled["aqt-retirement evaluate-disabled"]
    cleanReview{"All disabled gates pass?"}
    cleanWait["AWAITING CLEANUP APPROVAL"]
    manifest["Exact cleanup manifest<br/>no globs, traversal, or broad roots"]
    cleanSign["Offline Ed25519 approval<br/>scope: remove_and_clean"]
    cleanup["Mechanical cleanup PR<br/>host retirement + native package cutover"]
    halted["HALTED<br/>no automatic action or MT5 restart"]

    nativeRaw --> native
    native --> readiness
    archiveRaw --> archive
    archive --> legacy
    legacyRaw --> legacy
    legacy --> readiness
    readiness --> evaluate
    evaluate --> stopReview
    stopReview -- no --> halted
    stopReview -- yes --> stopWait
    stopWait --> stopSign
    stopSign --> disable
    disable --> observe
    observe --> disabled
    disabled --> cleanReview
    cleanReview -- no --> halted
    cleanReview -- yes --> cleanWait
    cleanWait --> manifest
    manifest --> cleanSign
    cleanSign --> cleanup
