{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "aqt_market_data_connected", "refId": "A"}],
      "title": "Recorder connected",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "rate(aqt_market_data_bytes_total[1m])", "refId": "A"}],
      "title": "Inbound bytes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "B"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4},
      "id": 3,
      "targets": [{"expr": "aqt_market_data_disk_free_bytes", "refId": "A"}],
      "title": "Recorder free disk",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
      "id": 4,
      "targets": [
        {"expr": "sum by (reason) (increase(aqt_market_data_reconnects_total[1h]))", "refId": "A"},
        {"expr": "sum by (kind, code) (increase(aqt_market_data_quality_issues_total[1h]))", "refId": "B"}
      ],
      "title": "Reconnects and quality issues",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["aiquanttrader", "market-data"],
  "templating": {
    "list": [
