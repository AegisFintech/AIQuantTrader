{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "id": 16,
      "title": "Live decision — action and exact gate",
      "type": "stat",
      "description": "The latest deterministic strategy action. LLM output cannot change this decision.",
      "targets": [
        {
          "expr": "aqt_paper_strategy_decision_info",
          "legendFormat": "{{action}} — {{reason}}"
        }
      ],
      "options": {"textMode": "name", "colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 0}
    },
    {
      "id": 17,
      "title": "BTC execution market",
      "type": "stat",
      "targets": [
        {"expr": "aqt_paper_market_price_usd", "legendFormat": "mid"},
        {"expr": "aqt_paper_best_bid_usd", "legendFormat": "best bid"},
        {"expr": "aqt_paper_best_ask_usd", "legendFormat": "best ask"},
        {"expr": "aqt_paper_spread_bps", "legendFormat": "spread bps"}
      ],
      "fieldConfig": {"defaults": {"decimals": 2}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 0}
    },
    {
      "id": 18,
      "title": "Entry economics and confluence",
      "type": "stat",
      "targets": [
        {"expr": "aqt_paper_expected_edge_bps", "legendFormat": "expected / open move bps"},
        {"expr": "aqt_paper_required_edge_bps", "legendFormat": "required cost edge bps"},
        {"expr": "aqt_paper_smc_confluence_score{side=\"long\"}", "legendFormat": "long score"},
        {"expr": "aqt_paper_smc_confluence_score{side=\"short\"}", "legendFormat": "short score"}
      ],
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 0}
    },
    {
      "id": 19,
      "title": "Causal 15m / 5m / 1m bias",
      "type": "stat",
      "targets": [
        {
          "expr": "aqt_paper_structure_direction == 1",
          "legendFormat": "{{timeframe}} {{direction}}"
        }
      ],
      "options": {"textMode": "name", "graphMode": "none"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 7}
    },
    {
      "id": 20,
      "title": "Price, support/resistance, stop and target",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_market_price_usd", "legendFormat": "BTC mid"},
        {
          "expr": "aqt_paper_structure_level_usd{timeframe=~\"5m|15m\"}",
          "legendFormat": "{{timeframe}} {{kind}}"
        },
        {"expr": "aqt_paper_exit_level_usd", "legendFormat": "{{kind}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 7}
    },
    {
      "id": 21,
      "title": "L2 book and aggressive tape pressure",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_book_imbalance", "legendFormat": "book imbalance"},
        {"expr": "aqt_paper_trade_flow_imbalance", "legendFormat": "trade-flow imbalance"}
      ],
      "fieldConfig": {"defaults": {"min": -1, "max": 1}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 7}
    },
    {
      "id": 1,
      "title": "Paper safety state",
      "type": "stat",
      "targets": [
        {"expr": "aqt_paper_feed_connected", "legendFormat": "feed connected"},
        {"expr": "aqt_paper_feature_ready", "legendFormat": "features ready"},
        {"expr": "aqt_paper_adaptive_forecast_ready", "legendFormat": "forecast ready"},
        {"expr": "aqt_paper_operator_kill", "legendFormat": "operator kill"}
      ],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 14}
    },
    {
      "id": 2,
      "title": "Marked PnL",
      "type": "stat",
      "targets": [{"expr": "aqt_paper_pnl_usd", "legendFormat": "USD"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 14}
    },
    {
      "id": 3,
      "title": "Market states",
      "type": "stat",
      "targets": [{"expr": "aqt_paper_market_states_total", "legendFormat": "processed"}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 4, "x": 12, "y": 14}
    },
    {
      "id": 4,
      "title": "Risk decisions",
      "type": "stat",
      "targets": [
        {"expr": "sum(aqt_paper_risk_decisions_total) or vector(0)", "legendFormat": "total"}
      ],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 4, "x": 16, "y": 14}
    },
    {
      "id": 5,
      "title": "Paper fills",
      "type": "stat",
      "targets": [{"expr": "sum(aqt_paper_fills_total) or vector(0)", "legendFormat": "total"}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 4, "x": 20, "y": 14}
    },
    {
      "id": 6,
      "title": "Marked equity and PnL",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_equity_usd", "legendFormat": "equity"},
        {"expr": "aqt_paper_pnl_usd", "legendFormat": "PnL"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 20}
    },
    {
      "id": 7,
      "title": "Position and open orders",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_position_base", "legendFormat": "BTC position"},
        {"expr": "aqt_paper_open_orders", "legendFormat": "open orders"}
      ],
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 20}
    },
    {
      "id": 8,
      "title": "Loss and drawdown budget",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_daily_loss_fraction", "legendFormat": "daily loss (limit 0.5%)"},
        {"expr": "aqt_paper_drawdown_fraction", "legendFormat": "drawdown (limit 1.0%)"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 20}
    },
    {
      "id": 9,
      "title": "Risk decision rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (result, reason) (rate(aqt_paper_risk_decisions_total[5m]))",
          "legendFormat": "{{result}} {{reason}}"
        }
      ],
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 27}
    },
    {
      "id": 10,
      "title": "Maker / taker fill rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (liquidity) (rate(aqt_paper_fills_total[5m]))",
          "legendFormat": "{{liquidity}}"
        }
      ],
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 27}
    },
    {
      "id": 11,
      "title": "PnL attribution",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_realized_trading_pnl_usd", "legendFormat": "realized trading"},
        {"expr": "-aqt_paper_fees_usd", "legendFormat": "fees"},
        {"expr": "aqt_paper_funding_pnl_usd", "legendFormat": "funding"},
        {"expr": "aqt_paper_daily_pnl_usd", "legendFormat": "daily marked"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 27}
    },
    {
      "id": 12,
      "title": "Decision-to-journal latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aqt_paper_cycle_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 34}
    },
    {
      "id": 13,
      "title": "Fill markout distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aqt_paper_fill_markout_bps_bucket[15m])))",
          "legendFormat": "median"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bps"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 34}
    },
    {
      "id": 14,
      "title": "Stale input exclusions",
      "type": "timeseries",
      "description": "Stale trades or L2 books are archived but excluded before features. Sustained growth requires review.",
      "targets": [
        {"expr": "aqt_paper_stale_trades_excluded_total", "legendFormat": "trades"},
        {"expr": "aqt_paper_stale_books_excluded_total", "legendFormat": "L2 books"}
      ],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 34}
    },
    {
      "id": 15,
      "title": "Feature drift",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_drift_ready", "legendFormat": "drift ready"},
        {"expr": "aqt_paper_drift_maximum_psi", "legendFormat": "max PSI"},
        {
          "expr": "aqt_paper_drift_maximum_standardized_mean_shift",
          "legendFormat": "max mean shift"
        }
      ],
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 41}
    },
    {
      "id": 22,
      "title": "Scalp lifecycle — hard cap 180 seconds",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_position_age_seconds", "legendFormat": "position age"},
        {"expr": "vector(60)", "legendFormat": "no-progress review"},
        {"expr": "vector(180)", "legendFormat": "mandatory exit"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 48}
    },
    {
      "id": 23,
      "title": "Why the strategy acted or stayed out",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (action, reason) (rate(aqt_paper_strategy_actions_total[5m]))",
          "legendFormat": "{{action}} — {{reason}}"
        }
      ],
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 48}
    },
    {
      "id": 24,
      "title": "LLM shadow observer (never execution authority)",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_llm_confidence", "legendFormat": "latest confidence"},
        {
          "expr": "sum by (verdict) (increase(aqt_paper_llm_confirmations_total[1h])) or vector(0)",
          "legendFormat": "{{verdict}} confirmations"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aqt_paper_llm_latency_seconds_bucket[1h])))",
          "legendFormat": "p95 latency seconds"
        }
      ],
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 48}
    },
    {
      "id": 25,
      "title": "Self-learning forecast state",
      "type": "stat",
      "description": "Paper-only causal learner. Production can consume only a frozen, separately approved artifact.",
      "targets": [
        {"expr": "aqt_paper_adaptive_forecast_ready", "legendFormat": "ready"},
        {"expr": "aqt_paper_adaptive_forecast_training_samples", "legendFormat": "resolved labels"},
        {"expr": "aqt_paper_adaptive_forecast_bps", "legendFormat": "30s forecast bps"}
      ],
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 55}
    },
    {
      "id": 26,
      "title": "Forecast quality gate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "aqt_paper_adaptive_forecast_directional_accuracy",
          "legendFormat": "directional accuracy"
        },
        {"expr": "vector(0.54)", "legendFormat": "minimum accuracy"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 55}
    },
    {
      "id": 27,
      "title": "Forecast error and economic hurdle",
      "type": "timeseries",
      "targets": [
        {"expr": "aqt_paper_adaptive_forecast_mae_bps", "legendFormat": "forecast MAE"},
        {"expr": "abs(aqt_paper_adaptive_forecast_bps)", "legendFormat": "absolute forecast"},
        {"expr": "aqt_paper_required_edge_bps", "legendFormat": "entry hurdle"}
      ],
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 55}
    }
  ],
  "refresh": "2s",
  "schemaVersion": 39,
  "tags": ["aiquanttrader", "paper", "btc"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "utc",
  "title": "AIQuantTrader BTC Scalping Command Center",
