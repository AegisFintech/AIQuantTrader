{
  "additionalProperties": false,
  "description": "Human-signed authority for one exact canary or production deployment.",
  "properties": {
    "account_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Account Address",
      "type": "string"
    },
    "approval_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Approval Id",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approver": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Approver",
      "type": "string"
    },
    "artifact_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Manifest Sha256",
      "type": "string"
    },
    "canary_evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canary Evidence Sha256"
    },
    "capital_limit_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
          "type": "string"
        }
      ],
      "title": "Capital Limit Usd"
    },
    "commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "control_wallet_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Control Wallet Address",
      "type": "string"
    },
    "dataset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "deployment_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Deployment Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "feature_schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Schema Sha256",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "instrument_id": {
      "const": "BTC-USD-PERP.HYPERLIQUID",
      "default": "BTC-USD-PERP.HYPERLIQUID",
      "title": "Instrument Id",
      "type": "string"
    },
    "model_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Sha256",
      "type": "string"
    },
    "prior_approval_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prior Approval Id"
    },
    "risk_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Risk Policy Sha256",
      "type": "string"
    },
    "rollback_deployment_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Rollback Deployment Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "shadow_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Shadow Evidence Sha256",
      "type": "string"
    },
    "stage": {
      "enum": [
        "approved_canary",
        "production"
      ],
      "title": "Stage",
      "type": "string"
    },
    "strategy_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Strategy Config Sha256",
      "type": "string"
    },
    "testnet_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Testnet Evidence Sha256",
      "type": "string"
    },
    "trading_wallet_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Trading Wallet Address",
      "type": "string"
    },
    "vault_address": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vault Address"
    }
  },
  "required": [
    "approval_id",
    "deployment_id",
    "stage",
    "account_address",
    "trading_wallet_address",
    "control_wallet_address",
    "commit_sha",
    "image_digest",
    "artifact_manifest_sha256",
    "dependency_lock_sha256",
    "dataset_sha256",
    "model_sha256",
    "configuration_sha256",
    "feature_schema_sha256",
    "strategy_config_sha256",
    "risk_policy_sha256",
    "shadow_evidence_sha256",
    "testnet_evidence_sha256",
    "capital_limit_usd",
    "rollback_deployment_id",
    "approver",
    "approved_at",
    "expires_at"
  ],
  "title": "DeploymentApproval",
  "type": "object"
}
