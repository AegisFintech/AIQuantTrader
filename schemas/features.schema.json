{
  "$defs": {
    "FeatureDatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "feature_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Config Sha256",
          "type": "string"
        },
        "feature_dataset_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Dataset Id",
          "type": "string"
        },
        "feature_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Schema Sha256",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "first_receive_ts_ns": {
          "minimum": 0,
          "title": "First Receive Ts Ns",
          "type": "integer"
        },
        "last_receive_ts_ns": {
          "minimum": 0,
          "title": "Last Receive Ts Ns",
          "type": "integer"
        },
        "relative_path": {
          "pattern": "^[A-Za-z0-9_./=:-]+$",
          "title": "Relative Path",
          "type": "string"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_dataset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Dataset Sha256",
          "type": "string"
        }
      },
      "required": [
        "feature_dataset_id",
        "source_dataset_sha256",
        "feature_schema_sha256",
        "feature_config_sha256",
        "relative_path",
        "file_sha256",
        "row_count",
        "first_receive_ts_ns",
        "last_receive_ts_ns"
      ],
      "title": "FeatureDatasetManifest",
      "type": "object"
    },
    "FeatureDefinition": {
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "const": "float64",
          "default": "float64",
          "title": "Dtype",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "FeatureDefinition",
      "type": "object"
    },
    "FeatureEngineConfig": {
      "additionalProperties": false,
      "properties": {
        "depth_levels": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Depth Levels",
          "type": "integer"
        },
        "feature_set": {
          "const": "btc-microstructure-v1",
          "default": "btc-microstructure-v1",
          "title": "Feature Set",
          "type": "string"
        },
        "fill_model_calibrated": {
          "default": false,
          "title": "Fill Model Calibrated",
          "type": "boolean"
        },
        "fill_model_id": {
          "default": "heuristic-uncalibrated-v1",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Fill Model Id",
          "type": "string"
        },
        "flow_window_ns": {
          "default": 5000000000,
          "exclusiveMinimum": 0,
          "title": "Flow Window Ns",
          "type": "integer"
        },
        "high_volatility_bps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "8",
          "title": "High Volatility Bps"
        },
        "inventory_limit_base": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.05",
          "title": "Inventory Limit Base"
        },
        "low_volatility_bps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1.5",
          "title": "Low Volatility Bps"
        },
        "markout_horizon_ns": {
          "default": 1000000000,
          "exclusiveMinimum": 0,
          "title": "Markout Horizon Ns",
          "type": "integer"
        },
        "maximum_input_age_ns": {
          "default": 2000000000,
          "exclusiveMinimum": 0,
          "title": "Maximum Input Age Ns",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "spread_window_ns": {
          "default": 30000000000,
          "exclusiveMinimum": 0,
          "title": "Spread Window Ns",
          "type": "integer"
        },
        "volatility_window_ns": {
          "default": 30000000000,
          "exclusiveMinimum": 0,
          "title": "Volatility Window Ns",
          "type": "integer"
        },
        "warmup_samples": {
          "default": 20,
          "minimum": 2,
          "title": "Warmup Samples",
          "type": "integer"
        }
      },
      "title": "FeatureEngineConfig",
      "type": "object"
    },
    "FeatureSchema": {
      "additionalProperties": false,
      "properties": {
        "feature_set": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Feature Set",
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/FeatureDefinition"
          },
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
