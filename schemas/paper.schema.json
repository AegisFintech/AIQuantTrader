          "title": "Regimes",
          "type": "array"
        },
        "report_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scenario Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity_scenarios": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Sensitivity Scenarios",
          "type": "array"
        },
        "strategy_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Strategy Config Sha256",
          "type": "string"
        },
        "strategy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Strategy Id",
          "type": "string"
        }
      },
      "required": [
