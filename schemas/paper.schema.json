{
  "$defs": {
    "CalibrationState": {
      "enum": [
        "uncalibrated",
        "calibrated"
      ],
      "title": "CalibrationState",
      "type": "string"
    },
    "OrderIntent": {
      "additionalProperties": false,
      "properties": {
        "created_ts_ns": {
          "minimum": 0,
          "title": "Created Ts Ns",
          "type": "integer"
        },
        "instrument_id": {
          "const": "BTC-USD-PERP.HYPERLIQUID",
          "default": "BTC-USD-PERP.HYPERLIQUID",
          "title": "Instrument Id",
          "type": "string"
        },
        "intent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Intent Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OrderKind"
        },
        "limit_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "post_only": {
          "default": false,
          "title": "Post Only",
          "type": "boolean"
        },
        "quantity_base": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity Base"
        },
        "rationale": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "reduce_only": {
          "default": false,
          "title": "Reduce Only",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "side": {
          "$ref": "#/$defs/OrderSide"
        },
        "strategy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Strategy Id",
          "type": "string"
        },
        "time_in_force": {
          "$ref": "#/$defs/TimeInForce",
          "default": "gtc"
        }
      },
      "required": [
        "intent_id",
        "strategy_id",
        "side",
        "kind",
        "quantity_base",
        "created_ts_ns",
        "rationale"
      ],
      "title": "OrderIntent",
      "type": "object"
    },
    "OrderKind": {
      "enum": [
        "limit",
        "market"
      ],
      "title": "OrderKind",
      "type": "string"
    },
    "OrderSide": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "OrderSide",
      "type": "string"
    },
    "PaperAccountState": {
      "additionalProperties": false,
      "properties": {
        "average_entry_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Entry Price"
        },
        "cash_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cash Usd"
        },
        "day_start_equity_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Day Start Equity Usd"
        },
        "equity_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Equity Usd"
        },
        "fees_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Fees Usd"
        },
        "funding_pnl_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Funding Pnl Usd"
        },
        "high_water_equity_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "High Water Equity Usd"
        },
        "last_funding_settlement_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Funding Settlement Ns"
        },
        "mark_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Mark Price"
        },
        "position_base": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Position Base"
        },
        "realized_trading_pnl_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Realized Trading Pnl Usd"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "updated_ts_ns": {
          "minimum": 0,
          "title": "Updated Ts Ns",
          "type": "integer"
        },
        "utc_day": {
          "minimum": 0,
          "title": "Utc Day",
          "type": "integer"
        }
      },
      "required": [
        "cash_usd",
        "mark_price",
        "equity_usd",
        "day_start_equity_usd",
        "high_water_equity_usd",
        "utc_day",
        "updated_ts_ns"
      ],
      "title": "PaperAccountState",
      "type": "object"
    },
    "PaperCommandKind": {
      "enum": [
        "submit",
        "cancel",
        "cancel_all"
      ],
      "title": "PaperCommandKind",
      "type": "string"
    },
    "PaperDecisionRecord": {
      "additionalProperties": false,
      "properties": {
        "decision_ts_ns": {
          "minimum": 0,
          "title": "Decision Ts Ns",
          "type": "integer"
        },
        "feature_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Snapshot Sha256",
          "type": "string"
        },
        "independent": {
          "title": "Independent",
          "type": "boolean"
        },
        "intent": {
          "$ref": "#/$defs/OrderIntent"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "risk_decision": {
          "$ref": "#/$defs/RiskDecision"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "strategy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Strategy Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "sequence",
        "decision_ts_ns",
        "feature_snapshot_sha256",
        "strategy_id",
        "intent",
        "risk_decision",
        "independent"
      ],
      "title": "PaperDecisionRecord",
      "type": "object"
    },
    "PaperEngineCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_ts_ns": {
          "minimum": 0,
          "title": "Checkpoint Ts Ns",
          "type": "integer"
        },
        "funding_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Funding Rate"
        },
        "last_independent_decision_ts_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Independent Decision Ts Ns"
        },
        "next_funding_settlement_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Funding Settlement Ns"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "source_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sequence"
        },
        "strategy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Strategy Id",
          "type": "string"
        },
        "strategy_memory_json": {
          "maxLength": 65536,
          "minLength": 2,
          "title": "Strategy Memory Json",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "sequence",
        "checkpoint_ts_ns",
        "strategy_id",
        "strategy_memory_json"
      ],
      "title": "PaperEngineCheckpoint",
      "type": "object"
    },
    "PaperEvidencePolicy": {
      "additionalProperties": false,
      "properties": {
        "decision_independence_ns": {
          "exclusiveMinimum": 0,
          "title": "Decision Independence Ns",
          "type": "integer"
        },
        "drift_baseline_samples": {
          "default": 1000,
          "minimum": 20,
          "title": "Drift Baseline Samples",
          "type": "integer"
        },
        "drift_evaluation_interval_samples": {
          "default": 100,
          "minimum": 1,
          "title": "Drift Evaluation Interval Samples",
          "type": "integer"
        },
        "drift_window_samples": {
          "default": 1000,
          "minimum": 20,
          "title": "Drift Window Samples",
          "type": "integer"
        },
        "frozen_at_ns": {
          "minimum": 0,
          "title": "Frozen At Ns",
          "type": "integer"
        },
        "maximum_adverse_markout_bps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Adverse Markout Bps"
        },
        "maximum_denial_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Denial Fraction"
        },
        "maximum_drawdown_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Drawdown Fraction"
        },
        "maximum_feature_psi": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.2",
          "title": "Maximum Feature Psi"
        },
        "maximum_standardized_mean_shift": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Maximum Standardized Mean Shift"
        },
        "minimum_fills": {
          "exclusiveMinimum": 0,
          "title": "Minimum Fills",
          "type": "integer"
        },
        "minimum_independent_decisions": {
          "exclusiveMinimum": 0,
          "title": "Minimum Independent Decisions",
          "type": "integer"
        },
        "minimum_observation_ns": {
          "exclusiveMinimum": 0,
          "title": "Minimum Observation Ns",
          "type": "integer"
        },
        "minimum_regimes": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Minimum Regimes",
          "type": "integer"
        },
        "policy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "require_positive_post_cost_pnl": {
          "default": true,
          "title": "Require Positive Post Cost Pnl",
          "type": "boolean"
        },
        "required_drills": {
          "default": [
            "restart",
            "stale_data",
            "daily_loss",
            "drawdown",
            "operator_kill",
            "observability"
          ],
          "items": {
            "enum": [
              "restart",
              "stale_data",
              "daily_loss",
              "drawdown",
              "operator_kill",
              "observability"
            ],
            "type": "string"
          },
          "title": "Required Drills",
          "type": "array"
        },
        "required_sensitivity_scenarios": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Sensitivity Scenarios",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "policy_id",
        "frozen_at_ns",
        "minimum_observation_ns",
        "minimum_independent_decisions",
        "decision_independence_ns",
        "minimum_fills",
        "maximum_drawdown_fraction",
        "maximum_denial_fraction",
        "maximum_adverse_markout_bps",
        "required_sensitivity_scenarios"
      ],
      "title": "PaperEvidencePolicy",
      "type": "object"
    },
    "PaperEvidenceReport": {
      "additionalProperties": false,
      "properties": {
        "approved_decisions": {
          "minimum": 0,
          "title": "Approved Decisions",
          "type": "integer"
        },
        "calibration_state": {
          "$ref": "#/$defs/CalibrationState"
