        "code_identity": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code Identity",
          "type": "string"
        },
        "completed_drills": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Completed Drills",
          "type": "array"
        },
        "config_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Fingerprint",
          "type": "string"
        },
        "denied_decisions": {
          "minimum": 0,
          "title": "Denied Decisions",
          "type": "integer"
        },
        "drift_evaluated": {
          "title": "Drift Evaluated",
          "type": "boolean"
        },
        "ending_position_base": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ending Position Base"
        },
        "feature_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
