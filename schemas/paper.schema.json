          "type": "string"
        },
        "fills": {
          "minimum": 0,
          "title": "Fills",
          "type": "integer"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/PaperGateResult"
          },
          "title": "Gates",
          "type": "array"
        },
        "generated_ts_ns": {
          "minimum": 0,
          "title": "Generated Ts Ns",
          "type": "integer"
        },
        "independent_decisions": {
          "minimum": 0,
          "title": "Independent Decisions",
          "type": "integer"
        },
        "invalidating_events": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Invalidating Events",
          "type": "array"
        },
        "markouts": {
          "minimum": 0,
          "title": "Markouts",
          "type": "integer"
        },
        "maximum_drawdown_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Drawdown Fraction"
        },
        "maximum_feature_psi": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Feature Psi"
        },
        "maximum_standardized_mean_shift": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Standardized Mean Shift"
        },
        "mean_adverse_markout_bps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Mean Adverse Markout Bps"
        },
        "observation_ended_ts_ns": {
          "minimum": 0,
          "title": "Observation Ended Ts Ns",
          "type": "integer"
        },
        "observation_ns": {
          "minimum": 0,
          "title": "Observation Ns",
          "type": "integer"
        },
        "observation_started_ts_ns": {
          "minimum": 0,
          "title": "Observation Started Ts Ns",
          "type": "integer"
        },
        "open_orders": {
          "minimum": 0,
          "title": "Open Orders",
          "type": "integer"
        },
        "policy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "post_cost_pnl_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Post Cost Pnl Usd"
        },
        "promotion_eligible": {
          "title": "Promotion Eligible",
          "type": "boolean"
        },
        "regimes": {
          "items": {
            "$ref": "#/$defs/VolatilityRegime"
