        "config_fingerprint",
        "feature_config_sha256",
        "strategy_config_sha256",
        "strategy_id",
        "scenario_id",
        "scenario_sha256",
        "calibration_state",
        "observation_started_ts_ns",
        "observation_ended_ts_ns",
        "observation_ns",
