{
  "$defs": {
    "ChampionChallengerReport": {
      "additionalProperties": false,
      "properties": {
        "challenger_experiment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Challenger Experiment Id",
          "type": "string"
        },
        "challenger_metrics_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Challenger Metrics Sha256",
          "type": "string"
        },
        "champion_experiment_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Champion Experiment Id"
        },
        "champion_metrics_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Champion Metrics Sha256"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/GateResult"
          },
          "minItems": 1,
          "title": "Gates",
          "type": "array"
        },
        "maximum_automation_stage": {
          "const": "awaiting_approval",
          "default": "awaiting_approval",
          "title": "Maximum Automation Stage",
          "type": "string"
        },
        "negative_controls_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Negative Controls Sha256",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "challenger_experiment_id",
        "policy_sha256",
        "challenger_metrics_sha256",
        "negative_controls_sha256",
        "gates",
        "passed"
      ],
      "title": "ChampionChallengerReport",
      "type": "object"
    },
    "DriftReport": {
      "additionalProperties": false,
      "properties": {
        "baseline_rows": {
          "exclusiveMinimum": 0,
