          "type": "boolean"
        },
        "feature_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Schema Sha256",
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/FeatureDrift"
          },
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "maximum_psi": {
          "minimum": 0,
          "title": "Maximum Psi",
          "type": "number"
        },
        "maximum_standardized_mean_shift": {
          "minimum": 0,
          "title": "Maximum Standardized Mean Shift",
          "type": "number"
