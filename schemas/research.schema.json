          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "feature_schema_sha256",
        "baseline_rows",
        "current_rows",
        "maximum_psi",
        "maximum_standardized_mean_shift",
        "drifted",
        "psi_threshold",
        "mean_shift_threshold",
