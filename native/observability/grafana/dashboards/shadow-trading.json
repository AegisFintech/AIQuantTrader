        {"expr": "aqt_shadow_counterfactual_equity_usd", "legendFormat": "equity"},
        {"expr": "aqt_shadow_counterfactual_position_base", "legendFormat": "BTC position"},
        {"expr": "aqt_shadow_counterfactual_open_orders", "legendFormat": "orders"}
