        "open_managed_positions",
        "open_unmanaged_positions",
        "pending_orders",
        "entry_pause_active",
        "command_file_writer_count",
        "final_trade_report_sha256",
        "final_status_sha256",
        "broker_account_state_sha256"
      ],
      "title": "LegacyFinalState",
      "type": "object"
