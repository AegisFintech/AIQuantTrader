      "enum": [
        "native_rollback",
        "backup_restore",
        "alert_delivery",
        "operator_access"
      ],
      "title": "RequiredNativeDrill",
      "type": "string"
    },
    "RetirementActionApproval": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Approval Id",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approver": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Approver",
          "type": "string"
        },
        "archive_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Archive Manifest Sha256",
          "type": "string"
        },
        "cleanup_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cleanup Manifest Sha256"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "final_tag_name": {
          "const": "mt5-final",
          "default": "mt5-final",
          "title": "Final Tag Name",
          "type": "string"
        },
        "native_admission_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Native Admission Id",
          "type": "string"
        },
        "native_deployment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Native Deployment Id",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "retirement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Retirement Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/RetirementActionScope"
        },
        "source_commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit Sha",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "retirement_id",
        "scope",
        "report_sha256",
        "native_deployment_id",
        "native_admission_id",
        "archive_manifest_sha256",
        "source_commit_sha",
        "approver",
        "approved_at",
        "expires_at"
      ],
      "title": "RetirementActionApproval",
      "type": "object"
    },
    "RetirementActionScope": {
      "enum": [
        "stop_and_observe",
        "remove_and_clean"
      ],
      "title": "RetirementActionScope",
      "type": "string"
    },
    "RetirementApprovalSignature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
