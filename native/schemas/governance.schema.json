          "type": "integer"
        },
        "signature_base64": {
          "maxLength": 88,
          "minLength": 88,
          "title": "Signature Base64",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "approval_sha256",
        "signature_base64"
      ],
      "title": "DetachedApprovalSignature",
      "type": "object"
    },
    "VerifiedDeploymentAdmission": {
      "additionalProperties": false,
      "properties": {
