        "signature_envelope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature Envelope Sha256",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "admission_id",
        "approval",
        "artifact_manifest",
        "public_key_sha256",
        "signature_envelope_sha256",
        "verified_at"
      ],
      "title": "VerifiedDeploymentAdmission",
      "type": "object"
    }
  },
  "anyOf": [
