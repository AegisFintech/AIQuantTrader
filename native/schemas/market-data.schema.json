    "AccountEventHeader": {
      "additionalProperties": false,
      "properties": {
        "account_address": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Address"
        },
        "connection_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Connection Id",
          "type": "string"
        },
        "event_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_ts_ns": {
          "minimum": 0,
          "title": "Event Ts Ns",
          "type": "integer"
        },
        "event_ts_source": {
          "$ref": "#/$defs/TimestampSource",
          "default": "exchange"
        },
        "receive_ts_ns": {
          "minimum": 0,
          "title": "Receive Ts Ns",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/EventSource",
          "default": "hyperliquid_websocket"
        },
        "source_record_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "venue": {
          "const": "HYPERLIQUID",
          "default": "HYPERLIQUID",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_ts_ns",
        "receive_ts_ns",
        "connection_id"
      ],
      "title": "AccountEventHeader",
      "type": "object"
    },
